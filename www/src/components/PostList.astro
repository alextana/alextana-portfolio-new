---
import { formatDate, type Post } from '../lib/posts';

interface Props {
	posts: Post[];
}

const { posts } = Astro.props;
---

<ul class="posts">
	{
		posts.map((post) => (
			<li>
				<a href={`/blog/${post.id}`}>
					<time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
					<span class="title">
						{post.data.title}
						{post.data.draft && <span class="draft">Draft</span>}
					</span>
					<span class="description">{post.data.description}</span>
				</a>
			</li>
		))
	}
</ul>

<style>
	.posts {
		padding: 0;
		list-style: none;
		border-top: 1px solid var(--rule);
	}

	li {
		border-bottom: 1px solid var(--rule);
	}

	a {
		display: grid;
		grid-template-columns: 11rem 1fr;
		gap: 0.25rem 2rem;
		padding-block: 1.5rem;
		text-decoration: none;
	}

	time {
		grid-row: span 2;
		font-size: 0.9rem;
		color: var(--muted);
	}

	.title {
		font-family: var(--font-display);
		font-size: 1.25rem;
		font-weight: 600;
		transition: color 0.15s;
	}

	a:hover .title {
		color: var(--accent);
	}

	.description {
		color: var(--muted);
	}

	.draft {
		margin-left: 0.5rem;
		padding: 0.1rem 0.5rem;
		border-radius: 999px;
		background: var(--rule);
		font-family: var(--font-body);
		font-size: 0.75rem;
		font-weight: 500;
		vertical-align: middle;
		color: var(--muted);
	}

	@media (max-width: 40rem) {
		a {
			grid-template-columns: 1fr;
		}

		time {
			grid-row: auto;
		}
	}
</style>
