---
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BeachDecor from '../components/BeachDecor.astro';
import CopyEmailToast from '../components/CopyEmailToast.astro';
import { site } from '../lib/site';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	/** Hide the header until the hero has scrolled out of view (homepage). */
	revealHeader?: boolean;
	/** Scroll-driven beach decorations in the margins, sized to the page's content column. */
	decor?: 'narrow' | 'wide';
}

const { title, description = site.description, revealHeader = false, decor } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.author} · ${site.role}`;
// Umami Cloud analytics: production builds only, so local dev visits aren't counted.
const umamiWebsiteId = import.meta.env.PROD ? import.meta.env.UMAMI_WEBSITE_ID : undefined;
---

<html lang="en-GB">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<Font cssVariable="--font-display" preload />
		<Font cssVariable="--font-body" preload />
		<Font cssVariable="--font-mono" preload />
		{umamiWebsiteId && (
			<script is:inline defer src="https://cloud.umami.is/script.js" data-website-id={umamiWebsiteId}></script>
		)}
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<Header revealAfterHero={revealHeader} />
		<main id="main" class:list={{ 'has-decor': decor }}>
			{decor && <BeachDecor column={decor} />}
			<slot />
		</main>
		<Footer />
		<CopyEmailToast />
	</body>
</html>

<style>
	/* Gives the decorations a box to fill and keeps them behind the content. */
	.has-decor {
		position: relative;
		isolation: isolate;
	}
</style>
